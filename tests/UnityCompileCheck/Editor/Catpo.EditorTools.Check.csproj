<!-- Unity의 Catpo.EditorTools 어셈블리(에디터 메뉴)와 같은 조건으로 컴파일한다. 규칙 코드와 다른 어셈블리라 internal 멤버를 못 쓴다. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Catpo.EditorTools</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/Assets/Scripts/Editor/**/*.cs" Link="Editor/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="../Core/Catpo.Core.Unity.csproj" />
    <ProjectReference Include="../UnityStub/UnityStub.csproj" />
  </ItemGroup>
</Project>
