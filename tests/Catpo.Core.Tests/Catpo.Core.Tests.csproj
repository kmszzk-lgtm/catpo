<Project Sdk="Microsoft.NET.Sdk">

  <!--
    게임 규칙 코드(unity/Assets/Scripts/Core)를 Unity 없이 테스트한다.
    원본은 Unity 프로젝트 안에 한 벌만 두고, 여기서는 링크해서 컴파일한다 (docs/06-tech.md).
    C# 문법은 Unity가 지원하는 9.0에 맞춘다.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Catpo.Core.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.2.1" />
  </ItemGroup>

</Project>
